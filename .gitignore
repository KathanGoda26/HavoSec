# ===================================
# HavoSec Main .gitignore
# ===================================

# Unwanted folders
.emergent/
test_reports/
*_backup/
backend_node/
memory/
tests/

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.iml

# Environment & Secrets
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
*.tmp
*.temp
.cache/
.temp/

# Build outputs (handled by subproject gitignores)
dist/
build/
*.pyc
__pycache__/
node_modules/

# Git config (personal)
.gitconfig
